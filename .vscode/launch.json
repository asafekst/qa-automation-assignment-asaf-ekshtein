{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "UI: all tests (parallel x2)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "module": "pytest",
      "args": ["tests/ui", "-v", "--browser=chromium", "-n", "2"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "UI: all tests",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "module": "pytest",
      "args": ["tests/ui", "-v", "--browser=chromium"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "API: all tests",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "module": "pytest",
      "args": ["tests/api", "-v"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "API: test_get_posts_returns_list_with_valid_schema",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "module": "pytest",
      "args": [
        "tests/api/test_posts.py::test_get_posts_returns_list_with_valid_schema",
        "-v",
        "-s"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "UI: cart (headed)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "module": "pytest",
      "args": [
        "tests/ui/test_cart.py",
        "-v",
        "-s",
        "--browser=chromium",
        "--headed",
        "--slowmo=500"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}
