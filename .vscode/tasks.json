{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "pytest: UI",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "pytest", "tests/ui", "--browser=chromium", "-n", "2"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "pytest: API",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "pytest", "tests/api"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test"
    }
  ]
}
